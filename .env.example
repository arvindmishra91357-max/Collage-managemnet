# ========================================================
# MGI College Management Portal - Environment Configuration
# ========================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_character_string

# Database Configuration (PostgreSQL for Production)
# Example: postgres://username:password@hostname:5432/mgi_portal?sslmode=require
DATABASE_URL=

# CORS & Network Configuration
CORS_ORIGINS=http://localhost:3000,https://mishra-group-institute-portal.onrender.com

# Production Anti-Cold-Start / Keepalive Monitor
KEEP_ALIVE_URL=https://mishra-group-institute-portal.onrender.com/api/health
KEEP_ALIVE_INTERVAL_MS=300000

# Persistent Storage Provider (Options: db, supabase, s3, local)
# Default 'db' stores files in PostgreSQL file_blobs table, persisting across all container redeployments
STORAGE_PROVIDER=db

# Optional Cloud Storage (Supabase Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=mgi-uploads

# Optional Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
